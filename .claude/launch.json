  "version": "0.0.1",
  "configurations": [
    {
      "name": "rajwadi-dine",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "exec python3 -m http.server \"${PORT:-8777}\" --bind 127.0.0.1 --directory site"
      ],
      "autoPort": true
    },
    {
      "name": "rajwadi-catering",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8778",
        "--bind",
        "127.0.0.1",
        "--directory",
        "../RajwadiThali_catering/site"
      ],
      "port": 8778
    },
    {
      "name": "liquid-glass",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "--prefix",
        "/Users/dhvippatel/Documents/liquid-glass",
        "dev",
        "--",
        "--port",
        "3111"
      ],
      "port": 3111
    }
  ]
